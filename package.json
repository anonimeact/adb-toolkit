{
  "name": "adb-toolkit",
  "displayName": "ADB Toolkit",
  "description": "ADB in VS Code: device sidebar, logcat terminal/webview, port forwarding, shell, and 40+ adb commands. No telemetry.",
  "version": "1.2.0",
  "publisher": "anonimeact",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "android",
    "adb",
    "debug",
    "mobile"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
