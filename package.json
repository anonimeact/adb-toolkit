      },
      {
        "command": "adbToolkit.removeAllForwards",
        "title": "ADB: Remove All Forwards",
        "category": "ADB Toolkit"
      },
      {
        "command": "adbToolkit.openShell",
        "title": "ADB: Open Shell",
        "category": "ADB Toolkit"
      },
      {
        "command": "adbToolkit.runCustomCommand",
        "title": "ADB: Run Custom Command",
        "category": "ADB Toolkit"
      },
      {
        "command": "adbToolkit.mirrorScrcpy",
        "title": "ADB: Mirror with scrcpy",
        "category": "ADB Toolkit"
      },
      {
        "command": "adbToolkit.scrcpySetupGuide",
        "title": "ADB: Scrcpy Setup Guide",
        "category": "ADB Toolkit"
      },
      {
        "command": "adbToolkit.scrcpyVersion",
        "title": "ADB: Scrcpy Version",
        "category": "ADB Toolkit"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "adbToolkit",
          "title": "ADB Toolkit",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "adbToolkit": [
        {
          "id": "adbToolkit.devices",
          "name": "Devices"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "adbToolkit.refreshDevices",
          "when": "view == adbToolkit.devices",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "adbToolkit.copyDeviceSerial",
          "when": "view == adbToolkit.devices",
          "group": "1_copy@1"
        },
        {
          "command": "adbToolkit.disconnectTreeDevice",
          "when": "view == adbToolkit.devices && viewItem == adbTcpDevice",
          "group": "2_connection@1"
        },
        {
          "command": "adbToolkit.mirrorScrcpy",
          "when": "view == adbToolkit.devices && viewItem =~ /adb(Device|TcpDevice)/",
          "group": "3_mirror@1"
        }
      ],
      "explorer/context": [
        {
          "command": "adbToolkit.installApk",
          "when": "resourceExtname == .apk",
          "group": "adbToolkit@1"
        }
      ]
    },
    "configuration": {
      "title": "ADB Toolkit",
      "properties": {
        "adbToolkit.adbPath": {
          "type": "string",
          "default": "adb",
          "description": "Path to the adb executable (adb, adb.exe, or full path to platform-tools)."
        },
        "adbToolkit.defaultPort": {
          "type": "number",
          "default": 5555,
          "description": "Default TCP port for adb tcpip and connect hints."
        },
        "adbToolkit.logcatDefaultFilter": {
          "type": "string",
          "default": "",
          "description": "Optional extra logcat filter spec (tag, text, or adb logcat args)."
        },
        "adbToolkit.logcatViewer": {
          "type": "string",
          "enum": ["terminal", "webview"],
          "default": "terminal",
          "description": "Where to stream logcat: integrated terminal or webview panel."
        },
        "adbToolkit.deviceRefreshIntervalMs": {
          "type": "number",
          "default": 5000,
          "minimum": 0,
          "description": "Auto-refresh device tree interval in ms (0 disables)."
        },
        "adbToolkit.scrcpyPath": {
          "type": "string",
          "default": "scrcpy",
          "description": "Path to the scrcpy executable (install manually — not bundled). See docs/SCRCPY.md in the extension or README."
        },
        "adbToolkit.scrcpyExtraArgs": {
          "type": "string",
          "default": "",
          "description": "Extra scrcpy arguments appended to every mirror session (e.g. --no-audio)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "pretest": "npm run compile",
    "test": "npm run test:unit",
    "test:unit": "tsx --test src/test/**/*.test.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.25.0",
    "mocha": "^11.0.0",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anonimeact/adb-toolkit"
  }
}
